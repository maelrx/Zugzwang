{
  "additionalProperties": false,
  "description": "Bounded configuration (PRD §38.3 'schema de config').\n\n``max_protocol_errors`` is an explicit operational decision (§15.2) with\nno default — callers must choose it. Feature flags are all off by default\n(G-CB-08: reanchoring, parallelism, visual and skills stay disabled until\nratified and capability-tested).",
  "properties": {
    "contract_version": {
      "const": 2,
      "default": 2,
      "title": "Contract Version",
      "type": "integer"
    },
    "max_rounds": {
      "minimum": 1,
      "title": "Max Rounds",
      "type": "integer"
    },
    "max_protocol_errors": {
      "minimum": 1,
      "title": "Max Protocol Errors",
      "type": "integer"
    },
    "enable_reanchoring": {
      "default": false,
      "title": "Enable Reanchoring",
      "type": "boolean"
    },
    "enable_parallelism": {
      "default": false,
      "title": "Enable Parallelism",
      "type": "boolean"
    },
    "enable_visual": {
      "default": false,
      "title": "Enable Visual",
      "type": "boolean"
    },
    "enable_skills": {
      "default": false,
      "title": "Enable Skills",
      "type": "boolean"
    }
  },
  "required": [
    "max_rounds",
    "max_protocol_errors"
  ],
  "title": "CognitiveBoardConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zugzwang.dev/schemas/cb-config/v1alpha1"
}
