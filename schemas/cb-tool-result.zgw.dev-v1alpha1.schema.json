{
  "$defs": {
    "RetryClass": {
      "description": "Loop effect of an error (PRD §15.1 'Efeito no loop' + §15.2).",
      "enum": [
        "repair_allowed",
        "no_execution_audited",
        "withhold_fact",
        "reject_may_end",
        "request_correct_input",
        "no_child",
        "no_transition",
        "reduce_or_finalize",
        "compact_or_finalize",
        "fail_closed",
        "pause_or_explicit_retry",
        "no_effect_acknowledged",
        "no_partial_output"
      ],
      "title": "RetryClass",
      "type": "string"
    },
    "ToolError": {
      "additionalProperties": false,
      "description": "One error result inside a tool envelope (PRD §15.1).",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ToolErrorCategory"
        },
        "retry_class": {
          "$ref": "#/$defs/RetryClass"
        },
        "details": {
          "additionalProperties": true,
          "default": {},
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "category",
        "retry_class"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ToolErrorCategory": {
      "description": "Category of a tool error (PRD §15.1).",
      "enum": [
        "contract",
        "safety",
        "exposure",
        "integrity",
        "state",
        "formal",
        "budget",
        "operational",
        "provenance",
        "compatibility",
        "transport",
        "infrastructure",
        "implementation"
      ],
      "title": "ToolErrorCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Normalized tool outcome: payload or catalogue error, never both.",
  "properties": {
    "operation_id": {
      "minLength": 8,
      "title": "Operation Id",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    }
  },
  "required": [
    "operation_id",
    "ok"
  ],
  "title": "ToolResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zugzwang.dev/schemas/cb-tool-result/v1alpha1"
}
